#!/bin/bash
# Refresh Grok usage whenever the agents panel regenerates its other
# usage files, and again on a 15-minute floor so Grok still updates if
# Claude/Codex/Fireworks are disabled.

set -euo pipefail

COLLECTOR="${OMARCHY_GROK_USAGE_COLLECTOR:-$HOME/.config/omarchy/agents/omarchy-agent-usage-grok}"
USAGE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/omarchy/agents/usage"
INTERVAL="${OMARCHY_GROK_USAGE_INTERVAL:-900}"

mkdir -p "$USAGE_DIR"

run() {
  python3 "$COLLECTOR" --write "$@" >/dev/null || true
}

run --force || true

if ! command -v inotifywait >/dev/null 2>&1; then
  while true; do
    sleep "$INTERVAL"
    run || true
  done
fi

while true; do
  # Timeout doubles as the periodic refresh. Exclude grok.json so our own
  # write cannot retrigger the loop.
  inotifywait -q -t "$INTERVAL" -e close_write,moved_to --exclude 'grok\.json' --format '%f' "$USAGE_DIR" >/dev/null 2>&1 || true
  sleep 1
  run || true
done
